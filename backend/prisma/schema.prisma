// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["fullTextSearch"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// ENUMS
// ============================================

enum UserRole {
  STUDENT      // Normal öğrenci
  ADMIN        // Sistem yöneticisi
  LIBRARIAN    // Kütüphaneci (check-in yapabilir)
  SUPER_ADMIN  // Süper yönetici (tüm yetkiler)

  @@map("user_role")
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  CHECKED_IN
  COMPLETED
  CANCELLED
  NO_SHOW

  @@map("reservation_status")
}

// YENİ EKLENEN ENUM: Katılımcı Onay Durumu
enum ParticipantStatus {
  PENDING     // Davet edildi, cevap bekleniyor
  ACCEPTED    // Kabul etti
  REJECTED    // Reddetti

  @@map("participant_status")
}

enum PenaltyType {
  NO_SHOW
  LATE_CANCELLATION
  REPEATED_OFFENSE

  @@map("penalty_type")
}

enum NotificationType {
  RESERVATION_REMINDER
  CANCELLATION
  PENALTY
  SYSTEM
  BAN_WARNING

  @@map("notification_type")
}

enum AdminActionType {
  USER_BANNED
  USER_UNBANNED
  PENALTY_ADDED
  PENALTY_REMOVED
  RESERVATION_CANCELLED
  RESERVATION_FORCE_CHECKIN
  ROOM_CREATED
  ROOM_UPDATED
  ROOM_DEACTIVATED
  SETTINGS_UPDATED
  USER_ROLE_CHANGED
  BULK_OPERATION

  @@map("admin_action_type")
}

enum BulkOperationStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  PARTIALLY_COMPLETED

  @@map("bulk_operation_status")
}

enum AnnouncementPriority {
  LOW
  MEDIUM
  HIGH
  URGENT

  @@map("announcement_priority")
}

enum TaskStatus {
  SCHEDULED
  RUNNING
  COMPLETED
  FAILED
  CANCELLED

  @@map("task_status")
}

// ============================================
// 1. KULLANICILAR (Users)
// ============================================
model User {
  id            String    @id @default(uuid()) @db.Uuid
  studentNumber String?   @unique @map("student_number") @db.VarChar(20)
  email         String    @unique @db.VarChar(255)
  fullName      String    @map("full_name") @db.VarChar(255)
  phone         String?   @db.VarChar(20)
  department    String?   @db.VarChar(100)
  avatarUrl     String?   @map("avatar_url") @db.Text
  acceptedAgreementVersion String? @map("accepted_agreement_version") @db.VarChar(20)
  
  // Rol ve yetki sistemi
  role      UserRole @default(STUDENT)
  isActive Boolean  @default(true) @map("is_active")

  // Ceza sistemi
  penaltyPoints Int       @default(0) @map("penalty_points")
  isBanned      Boolean   @default(false) @map("is_banned")
  banUntil      DateTime? @map("ban_until") @db.Timestamp(6)
  banReason     String?   @map("ban_reason") @db.Text

  // Son giriş bilgileri
  lastLoginAt DateTime? @map("last_login_at") @db.Timestamp(6)
  lastLoginIp String?   @map("last_login_ip") @db.Inet

  // Timestamps
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamp(6)

  // İlişkiler - NextAuth
  accounts Account[]
  sessions Session[]

  // İlişkiler - Uygulama
  reservations           Reservation[]
  reservationParticipations ReservationParticipant[] // YENİ: Davet edildiği rezervasyonlar
  penaltyHistory         PenaltyHistory[]
  checkedInReservations  Reservation[]  @relation("CheckedInBy")
  auditLogs              AuditLog[]
  notifications          Notification[]
  adminActions           AdminAction[]  @relation("AdminUser")
  affectedByAdminActions AdminAction[]  @relation("AffectedUser")

  @@index([studentNumber])
  @@index([email])
  @@index([role])
  @@index([penaltyPoints])
  @@index([isBanned])
  @@map("users")
}

// ============================================
// NEXTAUTH TABLES
// ============================================

// NextAuth Account (OAuth providers)
model Account {
  id                String  @id @default(uuid()) @db.Uuid
  userId            String  @map("user_id") @db.Uuid
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

// NextAuth Session
model Session {
  id           String   @id @default(uuid()) @db.Uuid
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id") @db.Uuid
  expires      DateTime @db.Timestamp(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

// NextAuth Verification Token (Email verification için)
model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime @db.Timestamp(6)

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ============================================
// 2. ODALAR (Rooms)
// ============================================
model Room {
  id          String   @id @default(uuid()) @db.Uuid
  roomNumber  String   @unique @map("room_number") @db.VarChar(10)
  name        String   @db.VarChar(100)
  capacity    Int      @default(7)

  // floor       Int?
  // description String?  @db.Text
  // amenities   Json?    @db.JsonB // {"projector": true, "whiteboard": true, "computers": 4, "outlets": 8}
  // imageUrl    String?  @map("image_url") @db.VarChar(500)

  isActive    Boolean  @default(true) @map("is_active")

  // Timestamps
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamp(6)

  // İlişkiler
  reservations Reservation[]

  @@map("rooms")
}

// ============================================
// 3. REZERVASYONLAR (Reservations)
// ============================================
model Reservation {
  id              String            @id @default(uuid()) @db.Uuid
  roomId          String            @map("room_id") @db.Uuid
  userId          String            @map("user_id") @db.Uuid

  // Tarih ve saat bilgileri
  reservationDate DateTime          @map("reservation_date") @db.Date
  startTime       DateTime          @map("start_time") @db.Time(6)
  endTime         DateTime          @map("end_time") @db.Time(6)

  // DÜZENLENDİ: participant_count ve participants jsonb buradan kaldırıldı
  purpose         String?           @db.Text

  // Durum
  status ReservationStatus @default(PENDING)

  // İptal bilgileri
  cancelledAt        DateTime? @map("cancelled_at") @db.Timestamp(6)
  cancellationReason String?   @map("cancellation_reason") @db.Text

  // Check-in bilgileri
  checkedInAt   DateTime? @map("checked_in_at") @db.Timestamp(6)
  checkedInById String?   @map("checked_in_by") @db.Uuid

  // Ceza sistemi
  noShow         Boolean @default(false) @map("no_show")
  penaltyApplied Boolean @default(false) @map("penalty_applied")

  // Timestamps
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamp(6)

  // İlişkiler
  room         Room             @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  checkedInBy  User?            @relation("CheckedInBy", fields: [checkedInById], references: [id])
  penaltyHistory PenaltyHistory[]
  
  // YENİ EKLENEN: İlişkisel katılımcılar listesi
  participants ReservationParticipant[]

  @@unique([userId, reservationDate, startTime], name: "unique_user_time")
  @@index([roomId, reservationDate])
  @@index([userId])
  @@index([status])
  @@index([reservationDate, startTime])
  @@map("reservations")
}

// ============================================
// 3.1 YENİ TABLO: REZERVASYON KATILIMCILARI
// ============================================
model ReservationParticipant {
  id            String   @id @default(uuid()) @db.Uuid
  reservationId String   @map("reservation_id") @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  
  status        ParticipantStatus @default(PENDING)
  joinedAt      DateTime? @map("joined_at") @db.Timestamp(6)

  // İlişkiler
  reservation   Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  user          User        @relation(fields: [userId], references: [id])

  @@unique([reservationId, userId]) // Bir kişi aynı rezervasyona 2 kez eklenemez
  @@map("reservation_participants")
}

// ============================================
// 4. CEZA GEÇMİŞİ (Penalty History)
// ============================================
model PenaltyHistory {
  id            String      @id @default(uuid()) @db.Uuid
  userId        String      @map("user_id") @db.Uuid
  reservationId String?     @map("reservation_id") @db.Uuid

  penaltyType   PenaltyType @map("penalty_type")
  penaltyPoints Int         @map("penalty_points")
  description   String?     @db.Text

  appliedAt DateTime  @default(now()) @map("applied_at") @db.Timestamp(6)
  expiresAt DateTime? @map("expires_at") @db.Timestamp(6)
  isActive  Boolean   @default(true) @map("is_active")

  // İlişkiler
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  reservation Reservation? @relation(fields: [reservationId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([isActive])
  @@index([appliedAt])
  @@map("penalty_history")
}

// ============================================
// 5. SİSTEM AYARLARI (System Settings)
// ============================================
model SystemSetting {
  id           String   @id @default(uuid()) @db.Uuid
  settingKey   String   @unique @map("setting_key") @db.VarChar(100)
  settingValue Json     @map("setting_value") @db.JsonB
  description  String?  @db.Text
  category     String?  @db.VarChar(50) // general, reservation, penalty, notification, admin
  isPublic     Boolean  @default(false) @map("is_public") // Öğrencilere gösterilsin mi?
  updatedBy    String?  @map("updated_by") @db.Uuid
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamp(6)

  @@index([category])
  @@index([isPublic])
  @@map("system_settings")
}

// ============================================
// 6. REZERVASYON KURALLARI (Reservation Rules)
// ============================================
model ReservationRule {
  id        String   @id @default(uuid()) @db.Uuid
  ruleName  String   @unique @map("rule_name") @db.VarChar(100)
  ruleType  String   @map("rule_type") @db.VarChar(50)
  ruleValue Json     @map("rule_value") @db.JsonB
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  @@map("reservation_rules")
}

// ============================================
// 7. AUDIT LOG (İşlem Geçmişi)
// ============================================
model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String?  @map("user_id") @db.Uuid
  action     String   @db.VarChar(100)
  entityType String   @map("entity_type") @db.VarChar(50)
  entityId   String?  @map("entity_id") @db.Uuid
  oldData    Json?    @map("old_data") @db.JsonB
  newData    Json?    @map("new_data") @db.JsonB
  ipAddress  String?  @map("ip_address") @db.Inet
  userAgent  String?  @map("user_agent") @db.Text
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  // İlişkiler
  user User? @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

// ============================================
// 8. BİLDİRİMLER (Notifications)
// ============================================
model Notification {
  id                String           @id @default(uuid()) @db.Uuid
  userId            String           @map("user_id") @db.Uuid
  title             String           @db.VarChar(255)
  message           String           @db.Text
  type              NotificationType
  relatedEntityType String?          @map("related_entity_type") @db.VarChar(50)
  relatedEntityId   String?          @map("related_entity_id") @db.Uuid
  isRead            Boolean          @default(false) @map("is_read")
  sentAt            DateTime         @default(now()) @map("sent_at") @db.Timestamp(6)
  readAt            DateTime?        @map("read_at") @db.Timestamp(6)

  // İlişkiler
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
  @@index([sentAt])
  @@map("notifications")
}

// ============================================
// 9. ADMİN İŞLEMLERİ (Admin Actions)
// ============================================
model AdminAction {
  id               String          @id @default(uuid()) @db.Uuid
  adminId          String          @map("admin_id") @db.Uuid
  actionType       AdminActionType @map("action_type")
  targetEntityType String          @map("target_entity_type") @db.VarChar(50)
  targetEntityId   String?         @map("target_entity_id") @db.Uuid
  affectedUserId   String?         @map("affected_user_id") @db.Uuid

  description String  @db.Text
  reason      String? @db.Text
  oldData     Json?   @map("old_data") @db.JsonB
  newData     Json?   @map("new_data") @db.JsonB

  ipAddress String? @map("ip_address") @db.Inet
  userAgent String? @map("user_agent") @db.Text

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  // İlişkiler
  admin        User  @relation("AdminUser", fields: [adminId], references: [id])
  affectedUser User? @relation("AffectedUser", fields: [affectedUserId], references: [id])

  @@index([adminId])
  @@index([actionType])
  @@index([targetEntityType, targetEntityId])
  @@index([createdAt])
  @@map("admin_actions")
}

model Agreement {
  id          String   @id @default(uuid()) @db.Uuid
  title       String   @db.VarChar(200) // Örn: "2026 Kütüphane Kullanım Sözleşmesi"
  content     String   @db.Text         // Sözleşmenin tam metni
  version     String   @unique @db.VarChar(20) // Örn: "v1.0", "v1.1" (Benzersiz olmalı)
  isActive    Boolean  @default(false) @map("is_active") // Sadece 1 tanesi aktif olacak
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  @@map("agreements") // Veritabanındaki tablo adı
}

// ============================================
// 10. DASHBOARD İSTATİSTİKLERİ (Dashboard Stats)
// ============================================
model DashboardStats {
  id   String   @id @default(uuid()) @db.Uuid
  date DateTime @unique @db.Date

  // Rezervasyon istatistikleri
  totalReservations     Int @default(0) @map("total_reservations")
  completedReservations Int @default(0) @map("completed_reservations")
  cancelledReservations Int @default(0) @map("cancelled_reservations")
  noShowReservations    Int @default(0) @map("no_show_reservations")

  // Kullanıcı istatistikleri
  activeUsers Int @default(0) @map("active_users")
  newUsers    Int @default(0) @map("new_users")
  bannedUsers Int @default(0) @map("banned_users")

  // Oda kullanım istatistikleri
  roomUtilizationRate    Float @default(0) @map("room_utilization_rate")
  averageSessionDuration Float @default(0) @map("average_session_duration")
  peakHours              Json? @map("peak_hours") @db.JsonB

  // Ceza istatistikleri
  totalPenaltiesIssued Int @default(0) @map("total_penalties_issued")
  totalPenaltyPoints   Int @default(0) @map("total_penalty_points")

  // Oda bazlı istatistikler
  roomStats Json? @map("room_stats") @db.JsonB

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamp(6)

  @@index([date])
  @@map("dashboard_stats")
}

// ============================================
// 11. TOPLU İŞLEMLER (Bulk Operations)
// ============================================
model BulkOperation {
  id             String              @id @default(uuid()) @db.Uuid
  adminId        String              @map("admin_id") @db.Uuid
  operationType  String              @map("operation_type") @db.VarChar(50)

  totalItems     Int @map("total_items")
  processedItems Int @default(0) @map("processed_items")
  successItems   Int @default(0) @map("success_items")
  failedItems    Int @default(0) @map("failed_items")

  status BulkOperationStatus @default(PENDING)

  parameters Json? @db.JsonB
  results    Json? @db.JsonB
  errorLog   Json? @map("error_log") @db.JsonB

  startedAt   DateTime? @map("started_at") @db.Timestamp(6)
  completedAt DateTime? @map("completed_at") @db.Timestamp(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamp(6)

  @@index([adminId])
  @@index([status])
  @@index([createdAt])
  @@map("bulk_operations")
}

// ============================================
// 12. DUYURULAR (Announcements)
// ============================================
model Announcement {
  id          String               @id @default(uuid()) @db.Uuid
  title       Json                 // Çeviriler için JSONB (Örn: {"tr": "Sınav", "en": "Exam"})
  content     Json                 // Çeviriler için JSONB
  priority    AnnouncementPriority @default(MEDIUM)

  isActive    Boolean              @default(true) @map("is_active")
  isPinned    Boolean              @default(false) @map("is_pinned")

  targetRole  UserRole?            @map("target_role")

  publishedAt DateTime?            @map("published_at") @db.Timestamp(6)
  expiresAt   DateTime?            @map("expires_at") @db.Timestamp(6)

  createdBy   String               @map("created_by") @db.Uuid
  createdAt   DateTime             @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt   DateTime             @updatedAt @map("updated_at") @db.Timestamp(6)

  @@index([isActive, isPinned])
  @@index([publishedAt])
  @@index([targetRole])
  @@map("announcements")
}

// ============================================
// 13. RAPOR ŞABLONLARI (Report Templates)
// ============================================
model ReportTemplate {
  id          String  @id @default(uuid()) @db.Uuid
  name        String  @db.VarChar(100)
  description String? @db.Text
  reportType  String  @map("report_type") @db.VarChar(50)

  query   Json  @db.JsonB
  columns Json  @db.JsonB
  filters Json? @db.JsonB

  isActive Boolean @default(true) @map("is_active")
  isSystem Boolean @default(false) @map("is_system")

  createdBy String   @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamp(6)

  @@index([reportType])
  @@index([isActive])
  @@map("report_templates")
}

// ============================================
// 14. ZAMANLANMIŞ GÖREVLER (Scheduled Tasks)
// ============================================
model ScheduledTask {
  id             String     @id @default(uuid()) @db.Uuid
  taskName       String     @map("task_name") @db.VarChar(100)
  taskType       String     @map("task_type") @db.VarChar(50)

  cronExpression String?   @map("cron_expression") @db.VarChar(50)
  scheduledFor   DateTime? @map("scheduled_for") @db.Timestamp(6)

  status TaskStatus @default(SCHEDULED)

  parameters   Json?   @db.JsonB
  result       Json?   @db.JsonB
  errorMessage String? @map("error_message") @db.Text

  executionTime Int? @map("execution_time")

  lastRunAt DateTime? @map("last_run_at") @db.Timestamp(6)
  nextRunAt DateTime? @map("next_run_at") @db.Timestamp(6)

  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamp(6)

  @@index([status])
  @@index([nextRunAt])
  @@index([taskType])
  @@map("scheduled_tasks")
}

// ============================================
// 15. EMAIL KUYRUĞU (Email Queue)
// ============================================
model EmailQueue {
  id          String   @id @default(uuid()) @db.Uuid
  to          String   @db.VarChar(255)
  subject     String   @db.VarChar(500)
  body        String   @db.Text
  htmlBody    String?  @map("html_body") @db.Text

  priority    Int      @default(5)
  attempts    Int      @default(0)
  maxAttempts Int      @default(3) @map("max_attempts")

  status String @db.VarChar(20)

  sentAt       DateTime? @map("sent_at") @db.Timestamp(6)
  failedAt     DateTime? @map("failed_at") @db.Timestamp(6)
  errorMessage String?   @map("error_message") @db.Text

  metadata Json? @db.JsonB

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamp(6)

  @@index([status])
  @@index([priority])
  @@index([createdAt])
  @@map("email_queue")
}